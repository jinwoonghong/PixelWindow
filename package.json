{
  "name": "pixel-window",
  "version": "0.1.0",
  "description": "윈도우 오버레이 가상 애완동물 게임 - 픽셀 강아지 키우기",
  "main": "dist/main/index.js",
  "author": "PixelWindow Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "dist": "electron-builder",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.pixelwindow.app",
    "productName": "PixelWindow",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
